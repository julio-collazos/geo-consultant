---
// This page redirects to /book — the new primary conversion page.
// Anyone who has bookmarked /contact will land here and be forwarded automatically.
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const bookUrl = base + '/book'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${bookUrl}`} />
    <link rel="canonical" href={bookUrl} />
    <title>Redirecting…</title>
  </head>
  <body>
    <p>
      Redirecting to <a href={bookUrl}>booking page</a>…
    </p>
  </body>
</html>
