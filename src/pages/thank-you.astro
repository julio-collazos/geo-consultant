---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<DefaultLayout title="You're all set" description="Confirmation page.">
  <PageHeader title="You're all set" subtitle="We'll be in touch soon." bgType="gradient" />
  <section class="container my-16">
    <div class="confirmation-block">
      <Icon aria-hidden="true" name="lucide:circle-check" size={48} class="confirm-icon" />
      <p class="text-lg">
        Keep an eye on your inbox — and if you're waiting for a file, check your spam folder too.
      </p>
      <div class="flex flex-col gap-3 sm:flex-row justify-center mt-4">
        <Link href={base + '/'} isButton type="secondary" animateOnHover animationType="boop">
          <Icon aria-hidden="true" name="lucide:home" size={20} />
          Back to home
        </Link>
        <Link href={base + '/book'} isButton type="primary" animateOnHover animationType="boop">
          <Icon aria-hidden="true" name="lucide:calendar" size={20} />
          Book a free call
        </Link>
      </div>
    </div>
  </section>
</DefaultLayout>

<style lang="scss">
  .confirmation-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-m);
    padding: var(--space-2xl);
    max-width: 480px;
    margin: 0 auto;
  }

  .confirm-icon {
    color: var(--color-primary-400);
  }
</style>
