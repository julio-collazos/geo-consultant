---
import { Icon } from 'astro-icon/components'

// [USER INPUT REQUIRED] Replace these items with your real credentials.
// Update label text, icon names, and add/remove items as needed.
// Icon names come from lucide — browse at https://lucide.dev/icons/
const items = [
  //{ icon: 'lucide:shield-check', label: 'EUDR Geospatial Specialist' },
  { icon: 'lucide:map', label: '4+ Years Remote Sensing' },
  { icon: 'lucide:globe', label: 'Europe · Latin America · Africa' },
  //{ icon: 'lucide:graduation-cap', label: 'MSc Environmental Science / GIS' },
]
---

<section class="trust-bar" aria-label="Credentials">
  <div class="container">
    <ul class="trust-list">
      {
        items.map(({ icon, label }) => (
          <li class="trust-item">
            <Icon aria-hidden="true" name={icon} size="1.25rem" class="trust-icon" />
            <span>{label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style lang="scss">
  @use '../assets/scss/base/breakpoint' as *;

  .trust-bar {
    padding: var(--space-m) 0;
    border-top: 1px solid var(--border-color-subtle);
    border-bottom: 1px solid var(--border-color-subtle);
  }

  .trust-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-m) var(--space-xl);
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--font-size-0);
    font-weight: 500;
    opacity: 0.75;
  }

  .trust-icon {
    color: var(--color-primary-400);
    flex-shrink: 0;
  }
</style>
