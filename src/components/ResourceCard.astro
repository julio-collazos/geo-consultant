---
import { Badge } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'

interface Props {
  title: string
  description: string
  imageSrc?: string
  tags?: string[]
  format?: string
  pageCount?: string
}

const { title, description, imageSrc, tags = [], format, pageCount } = Astro.props
---

<div class="resource-card">
  {
    imageSrc && (
      <div class="resource-card__image-wrap">
        <img src={imageSrc} alt="" loading="lazy" class="resource-card__image" />
      </div>
    )
  }
  <div class="resource-card__body">
    <div class="resource-card__meta">
      {format && (
        <span class="resource-card__format">
          <Icon aria-hidden="true" name="lucide:file-text" size="1rem" />
          {format}
        </span>
      )}
      {pageCount && <span class="resource-card__pages">{pageCount}</span>}
    </div>

    {
      tags.length > 0 && (
        <div class="resource-card__tags">
          {tags.map((tag) => (
            <Badge>{tag}</Badge>
          ))}
        </div>
      )
    }

    <h2 class="resource-card__title">{title}</h2>
    <p class="resource-card__desc">{description}</p>

    <ul class="resource-card__highlights">
      <li>
        <Icon aria-hidden="true" name="lucide:check" size="1rem" class="icon-check" />
        Coordinate system requirements (WGS84 / EPSG:4326)
      </li>
      <li>
        <Icon aria-hidden="true" name="lucide:check" size="1rem" class="icon-check" />
        Geometry validation rules for EUDR submissions
      </li>
      <li>
        <Icon aria-hidden="true" name="lucide:check" size="1rem" class="icon-check" />
        File size limits and how to stay under them
      </li>
      <li>
        <Icon aria-hidden="true" name="lucide:check" size="1rem" class="icon-check" />
        12 most common errors with annotated GeoJSON examples
      </li>
    </ul>
  </div>
</div>

<style lang="scss">
  .resource-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-l);
    overflow: hidden;
    background: light-dark(white, var(--color-neutral-900));
  }

  .resource-card__image-wrap {
    aspect-ratio: var(--ratio-landscape);
    overflow: hidden;
  }

  .resource-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .resource-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-m);
  }

  .resource-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }

  .resource-card__format {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    font-size: var(--font-size--1);
    font-weight: 600;
    color: var(--color-primary-400);
    background: light-dark(
      color-mix(in srgb, var(--color-primary) 10%, white),
      color-mix(in srgb, var(--color-primary) 15%, var(--color-neutral-900))
    );
    padding: 0.2em 0.6em;
    border-radius: var(--radius-m);
  }

  .resource-card__pages {
    font-size: var(--font-size--1);
    opacity: 0.6;
  }

  .resource-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
  }

  .resource-card__title {
    font-size: var(--font-size-2);
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }

  .resource-card__desc {
    font-size: var(--font-size-0);
    opacity: 0.8;
    line-height: 1.6;
  }

  .resource-card__highlights {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin-top: var(--space-2xs);

    li {
      display: flex;
      align-items: flex-start;
      gap: var(--space-2xs);
      font-size: var(--font-size-0);
    }
  }

  .icon-check {
    color: var(--color-primary-400);
    flex-shrink: 0;
    margin-top: 0.15em;
  }
</style>
