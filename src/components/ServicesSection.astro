---
import Feature from '@components/Feature.astro'
import { Heading, Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'

interface Props {
  title?: string
  subtitle?: string
}

const {
  title = 'How I Can Help',
  subtitle = 'I work with sustainability teams, supply chain analysts, and GIS specialists across the full geospatial workflow — from raw data validation to decision-ready spatial intelligence.',
} = Astro.props

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<section class="services-section my-24">
  <div class="container">
    <div class="section-header">
      <Heading level="h2">{title}</Heading>
      <p class="subtitle">{subtitle}</p>
    </div>

    <div class="services-grid">
      <Feature icon="lucide:map-pin" title="EUDR Compliance Mapping">
        Validate and clean geospatial data for EUDR due diligence submissions. I audit supplier
        GeoJSON files, fix geometry errors, verify CRS compliance, and produce audit-ready outputs
        your compliance team can submit with confidence.
      </Feature>

      <Feature icon="lucide:route" title="Supply Chain Traceability">
        Map your sourcing areas at farm-plot level using GPS collection, satellite imagery, and
        local partner data. I build spatial databases that link commodity origin to processing
        facilities — ready for EUDR or investor ESG reporting.
      </Feature>

      <Feature icon="lucide:satellite" title="Remote Sensing Analysis">
        Extract land cover change, deforestation alerts, and vegetation indices from Landsat,
        Sentinel, and Planet imagery. I design analysis pipelines in Google Earth Engine and Python
        that turn raw satellite data into decision-ready indicators.
      </Feature>

      <Feature icon="lucide:bar-chart-2" title="Geospatial Data Strategy">
        Not sure where to start? I help sustainability and supply chain teams understand what
        spatial data they need, how to collect it cost-effectively, and how to build internal
        capacity to maintain it — delivered as a structured advisory engagement.
      </Feature>
    </div>

    <div class="services-cta">
      <Link href={base + '/book'} isButton type="primary" animateOnHover animationType="boop">
        <Icon aria-hidden="true" name="lucide:calendar" size="1.25rem" />
        Book a free 30-min call
      </Link>
    </div>
  </div>
</section>

<style lang="scss">
  @use '../assets/scss/base/breakpoint' as *;

  .section-header {
    margin-bottom: var(--space-xl);
  }

  .subtitle {
    font-size: var(--font-size-1);
    max-width: 60ch;
    opacity: 0.8;
    margin-top: var(--space-s);
    line-height: 1.65;
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);

    @include breakpoint(m) {
      grid-template-columns: repeat(2, 1fr);
    }

    @include breakpoint(xl) {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .services-cta {
    margin-top: var(--space-xl);
  }
</style>
